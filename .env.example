# LinkedIn Authentication Credentials
# (Required for fresh login; if data/session.json exists, saved session is reused)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# LLM API Keys for Planner
# (Optional; if unprovided, planner runs in intelligent mock mode)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Job Search Environment Overrides (Optional)
JOB_KEYWORDS=Software Engineer
JOB_LOCATION=United States

# Browser Configuration (Default: System Google Chrome, Non-Incognito Persistent Profile)
BROWSER_CHANNEL=chrome
BROWSER_PERSISTENT=true
# Specific Chrome Profile email or name (e.g. dhanyalakshmi.s.s.06@gmail.com)
CHROME_PROFILE=dhanyalakshmi.s.s.06@gmail.com
# CHROME_USER_DATA_DIR=data/chrome-profile
# Optional: Attach directly to an already running Chrome started with --remote-debugging-port=9222
# CDP_URL=http://localhost:9222
