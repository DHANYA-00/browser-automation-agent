# LinkedIn Authentication Credentials
# (Required for fresh login; if data/session.json exists, saved session is reused)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# LLM API Keys for Planner
# (Optional; if unprovided, planner runs in intelligent mock mode)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Job Search Environment Overrides (Optional)
JOB_KEYWORDS=Software Engineer
JOB_LOCATION=United States
